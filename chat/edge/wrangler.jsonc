{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "simni-chat-media-gateway",
  "main": "worker.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "r2_buckets": [
    {
      "binding": "CHAT_MEDIA_BUCKET",
      "bucket_name": "simni-chat-media"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
