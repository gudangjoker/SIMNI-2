      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || (root.child('users').child(auth.uid).child('role').val() == 'superuser' && root.child('users').child(auth.uid).child('status').val() == 'active' && auth.token.email == 'unggaran.sditbm@gmail.com'))",
