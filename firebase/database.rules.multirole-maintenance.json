                      ".validate": "$sectionIndex.matches(/^([0-9]|1[0-9]|2[0-5])$/) && newData.hasChildren(['id', 'title']) && newData.child('id').isString() && newData.child('title').isString() && newData.child('title').val().length <= 4000"
                    }
                  }
                }
              },
